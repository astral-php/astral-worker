{
    "name": "astral-php/astral-worker",
    "description": "File d'attente et worker pour Astral — mails et PDF en arrière-plan (sync, database, Redis)",
    "type": "library",
    "version": "0.1.0",
    "license": "MIT",
    "keywords": ["astral", "php", "queue", "worker", "jobs", "mvc"],
    "authors": [
        {
            "name": "astral-php",
            "homepage": "https://github.com/astral-php"
        }
    ],
    "homepage": "https://github.com/astral-php/astral-worker",
    "support": {
        "source": "https://github.com/astral-php/astral-worker",
        "issues": "https://github.com/astral-php/astral-worker/issues"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "astral-php/astral-core": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-redis": "Requis uniquement pour QUEUE_DRIVER=redis",
        "ext-pcntl": "Arrêt propre du worker sur SIGTERM/SIGINT (Linux/macOS)",
        "dompdf/dompdf": "Exemple de moteur PDF pour GeneratePdfJob (voir examples/)"
    },
    "autoload": {
        "psr-4": {
            "Astral\\Worker\\": "src/Astral/Worker/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Astral\\Worker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "astral-worker": {
            "stubs": "stubs",
            "migrations": "database/migrations"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
